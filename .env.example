# =====================================================================
# AI Commerce Discovery & Customer Support Platform Configuration
# =====================================================================

# Option A: Discrete MySQL / Aiven Configuration (Recommended)
MYSQL_HOST=mysql-your-project-account.aivencloud.com
MYSQL_PORT=24581
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_database_password
MYSQL_DB=ai_commerce_cleaned
MYSQL_SSL_MODE=REQUIRED
# Optional: path to downloaded ca.pem (only if custom CA is required)
# MYSQL_SSL_CA=C:/path/to/aiven-ca.pem

# Option B: Full Cloud Database URI (Alternative)
# DATABASE_URL=mysql://avnadmin:your_password@mysql-your-project-account.aivencloud.com:24581/ai_commerce_cleaned?ssl-mode=REQUIRED

# JWT Authentication Security
SECRET_KEY=generate_with_openssl_rand_hex_32_or_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & Network Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# AI / Copilot Configuration
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
