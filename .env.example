# =====================================================================
# MerchAI Platform — Local Development Environment Configuration (.env)
# =====================================================================
# Copy this file to '.env' in your local development workspace.
# DO NOT COMMIT '.env' TO GIT. NEVER PUT PRODUCTION CREDENTIALS HERE.
# =====================================================================

# Environment Mode: 'development' | 'testing' | 'production'
# In development/testing, safeguards prevent connecting to production cloud databases.
APP_ENV=development

# ---------------------------------------------------------------------
# Local Database Configuration (Separate Local Development Database)
# ---------------------------------------------------------------------
# Run a local MySQL instance (e.g. MySQL 8.0 via installer or Docker:
# docker run -d -p 3306:3306 -e MYSQL_ALLOW_EMPTY_PASSWORD=yes --name merchai-mysql mysql:8.0)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ai_commerce_dev
MYSQL_TEST_DB=ai_commerce_test

# SSL Mode: leave DISABLED for local development MySQL
MYSQL_SSL_MODE=DISABLED

# Optional: Full local database connection URL (Alternative to discrete vars)
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/ai_commerce_dev?charset=utf8mb4
# TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/ai_commerce_test?charset=utf8mb4

# ---------------------------------------------------------------------
# JWT Authentication Security
# ---------------------------------------------------------------------
# Generate a secure 32+ character random string for local session persistence:
# openssl rand -hex 32
# If omitted in development, a transient key will be generated for the session.
# In production (APP_ENV=production), a strong key is STRICTLY REQUIRED.
SECRET_KEY=generate_with_openssl_rand_hex_32_or_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# Server & Network Configuration
# ---------------------------------------------------------------------
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------------------------------------------------------------------
# AI / Copilot Configuration
# ---------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_API_KEY=mock_key

# ---------------------------------------------------------------------
# Production Cloud Database Safeguard Override
# ---------------------------------------------------------------------
# Development commands are blocked from connecting to production cloud databases.
# Only set to true from an authorized terminal for explicit, read-only diagnostic checks:
ALLOW_PRODUCTION_DB_ACCESS=false
