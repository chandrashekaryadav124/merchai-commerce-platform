# =====================================================================
# Git Ignore Configuration - AI Commerce Discovery Platform
# =====================================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!*.example
*.pem
*.key
*.cert
*.crt
*.pfx

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/
ENV/

# Node & Frontend build artifacts
node_modules/
dist/
build/
.oxlintrc.json
.eslintcache

# Database backups & dumps (Prevent accidental credential/data commit)
*.sql
!sql/schema_overview.sql
*.dump
*.tar.gz
*.bak
*.sqlite
*.sqlite3
*.db
platform.db

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
