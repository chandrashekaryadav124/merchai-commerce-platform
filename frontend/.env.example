# =====================================================================
# Frontend Environment Configuration (Vite)
# =====================================================================

# Backend API Base URL
# Local development default: http://localhost:8000/api/v1
# Vercel Production deployment: https://your-backend-name.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# SECURITY NOTICE:
# Never put database credentials, JWT secret keys, or private API secrets in this file.
# Any variable with the VITE_ prefix is embedded into client JavaScript and visible to all users.
